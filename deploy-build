echo "Deploying Server"
for i in $(seq 1 5); do echo deploying to gluster$i; ssh root@gluster$i systemctl stop dfs-server; scp target/release/dfs-server target/release/dfs-admin root@gluster$i:/usr/bin/; ssh root@gluster$i systemctl start dfs-server; sleep 1; done

for i in nanopir3.local theater.local rock5b.local
do
	echo "Deploying Client to $i"
	ssh root@$i killall dfs-client
	scp target/release/dfs-client target/release/dfs-admin root@$i:/usr/bin/
	ssh root@$i systemctl restart dfs-client
	sleep 1
done


